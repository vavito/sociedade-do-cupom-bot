APP_ENV=local
LOG_LEVEL=INFO

# Supabase recomendado: Session Pooler com SSL.
# Se a senha tiver caracteres especiais, use URL encode.
# Exemplo:
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database?ssl=require

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POST_BOT_ENABLED=true

ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_API_BASE_URL=https://api-sg.aliexpress.com/sync

SCHEDULER_INTERVAL_MINUTES=10
SCHEDULER_ENABLED=true
